    if input.KeyCode then
        local keyName = tostring(input.KeyCode)
        if Settings.Keybinds.ToggleAimbot == keyName then
            Settings.Enabled = not Settings.Enabled
            Toggle:Set(Settings.Enabled)
            SaveConfig()
            Rayfield:Notify({
                Title = "Aimbot",
                Content = Settings.Enabled and "Enabled" or "Disabled",
                Duration = 1
            })
        end
    end
end)

