local function CleanWhitelist()
    local validIds = {}
    for i = 1, #WhitelistIds do
        local userId = WhitelistIds[i]
        if Players:FindFirstChild(tostring(userId)) then
            table.insert(validIds, userId)
        end
    end
    WhitelistIds = validIds
    if #WhitelistIds ~= #validIds then
        RefreshWhitelistDisplay()
    end
end

