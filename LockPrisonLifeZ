local WhitelistTab = Window:CreateTab("Whitelist", 4483362458)

local function UpdateWhitelistDisplay()
    local playerList = {}
    for _, player in pairs(Players:GetPlayers()) do
        if Whitelist.Users[player.UserId] then
            table.insert(playerList, string.format("%s (%d)", player.DisplayName, player.UserId))
        end
    end
    local displayText = #playerList > 0 and table.concat(playerList, ", ") or "No users whitelisted"
    print("=== WHITELIST ===\n" .. displayText .. "\n=================")
end

WhitelistTab:CreateButton({
    Name = "Add Current Player to Whitelist",
    Callback = function()
        local player = LocalPlayer
        if not player then return end
        Whitelist.Users[player.UserId] = true
        UpdateWhitelistDisplay()
        Rayfield:Notify({
            Title = "Whitelist",
            Content = string.format("Added %s (%d) to whitelist", player.DisplayName, player.UserId),
            Duration = 3
        })
    end
})

WhitelistTab:CreateButton({
    Name = "Remove Selected Player (Check Console for IDs)",
    Callback = function()
        local players = Players:GetPlayers()
        local list = {}
        for i, player in pairs(players) do
            table.insert(list, string.format("[%d] %s (%d)", i, player.DisplayName, player.UserId))
        end
        print("=== SELECT A PLAYER TO REMOVE ===\n" .. table.concat(list, "\n") .. "\n===================================")
        Rayfield:Notify({
            Title = "Whitelist",
            Content = "Check console for player list. Use /wremove <ID>",
            Duration = 5
        })
    end
})

WhitelistTab:CreateButton({
    Name = "Remove All (Double-Click to Confirm)",
    Callback = function()
        if not Whitelist.removeCooldown then
            Whitelist.removeCooldown = true
            Whitelist.removeTimer = tick()
            Rayfield:Notify({
                Title = "Whitelist",
                Content = "Click again within 5 seconds to confirm remove all.",
                Duration = 5
            })
            task.wait(5)
            if Whitelist.removeTimer and (tick() - Whitelist.removeTimer) >= 5 then
                Whitelist.removeCooldown = false
                Whitelist.removeTimer = nil
            end
        else
            if Whitelist.removeTimer and (tick() - Whitelist.removeTimer) < 5 then
                Whitelist.Users = {}
                UpdateWhitelistDisplay()
                Rayfield:Notify({
                    Title = "Whitelist",
                    Content = "All users removed from whitelist.",
                    Duration = 3
                })
                Whitelist.removeCooldown = false
                Whitelist.removeTimer = nil
            end
        end
    end
})

game:GetService("Players").PlayerRemoving:Connect(function(player)
