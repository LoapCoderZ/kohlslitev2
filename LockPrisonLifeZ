local function RefreshWhitelistDisplay()
    local playerList = {}
    for i, userId in ipairs(WhitelistIds) do
        local player = Players:FindFirstChild(tostring(userId))
        if player then
            table.insert(playerList, string.format("%s (%d)", player.DisplayName, userId))
        else
            table.insert(playerList, string.format("User (%d)", userId))
        end
    end
    local displayText = #playerList > 0 and table.concat(playerList, ", ") or "Empty"
    print(string.format("Whitelist [%d]: %s", #WhitelistIds, displayText))
end

local function IsInWhitelist(player)
    local userId = player.UserId
    for i = 1, #WhitelistIds do
        if WhitelistIds[i] == userId then
            return true
        end
    end
    return false
end

WhitelistTab:CreateInput({
    Name = "Add Player to Whitelist",
    PlaceholderText = "Display Name or Username",
    Callback = function(Input)
        if Input and Input ~= "" then
            local found = false
            for _, player in pairs(Players:GetPlayers()) do
                if player.Name:lower() == Input:lower() or player.DisplayName:lower() == Input:lower() then
                    local userId = player.UserId
                    if not IsInWhitelist(player) then
                        table.insert(WhitelistIds, userId)
                        RefreshWhitelistDisplay()
                        Rayfield:Notify({
                            Title = "Whitelist",
                            Content = string.format("Added %s", player.DisplayName),
                            Duration = 3
                        })
                    else
                        Rayfield:Notify({
                            Title = "Whitelist",
                            Content = "Player already in whitelist",
                            Duration = 2
                        })
                    end
                    found = true
                    break
                end
            end
            if not found then
                Rayfield:Notify({
                    Title = "Whitelist",
                    Content = "Player not found in server",
                    Duration = 2
                })
            end
        end
    end
})

