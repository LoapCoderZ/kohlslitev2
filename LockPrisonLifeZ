if Settings.Enabled then
    Toggle:Set(true)
end

RunService.RenderStepped:Connect(function()
    if Settings.ShowFOV and Settings.Enabled then
        FOVCircle.Visible = true
        FOVCircle.Position = Camera.ViewportSize / 2
        FOVCircle.Radius = Settings.FOV
    else
        FOVCircle.Visible = false
    end

    if not Settings.Enabled then return end

    local targets = GetTargets()
    local best = GetBestTarget(targets)
    if best then
        local current = Camera.CFrame
        local lookAt = CFrame.lookAt(current.Position, best.targetPart.Position)
        local smooth = Settings.Smoothness
        Camera.CFrame = current:Lerp(lookAt, smooth)
    end
end)
