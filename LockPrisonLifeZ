local function SaveConfig()
    local success, encoded = pcall(HttpService.JSONEncode, HttpService, Settings)
    if success then
        local success2, err = pcall(writefile, CONFIG_PATH, encoded)
        if not success2 then
            warn("Failed to save config: " .. tostring(err))
        end
    else
        warn("Failed to encode config: " .. tostring(encoded))
    end
end

local function LoadConfig()
    local success, data = pcall(readfile, CONFIG_PATH)
    if success and data then
        local success2, decoded = pcall(HttpService.JSONDecode, HttpService, data)
        if success2 and type(decoded) == "table" then
            for key, value in pairs(decoded) do
                if key == "TargetTeams" then
                    for team, enabled in pairs(value) do
                        Settings.TargetTeams[team] = enabled
                    end
                elseif key == "Keybinds" then
                    for bind, keyCode in pairs(value) do
                        Settings.Keybinds[bind] = keyCode
                    end
                else
                    Settings[key] = value
                end
            end
            return true
        end
    end
    return false
end

local function IsKeyPressed(key)
    if key == "None" then return false end
    return UserInputService:IsKeyDown(Enum.KeyCode[key])
end

local function GetUniqueTeams()
    local teams = {}
    local allTeams = TeamsService:GetTeams()
    for _, team in ipairs(allTeams) do
        local teamName = team.Name
        if teamName ~= "Neutral" then
            teams[teamName] = true
        end
    end
    for _, player in pairs(Players:GetPlayers()) do
        if player.Team then
            local teamName = player.Team.Name
            if teamName ~= "Neutral" then
                teams[teamName] = true
            end
        else
            teams["No Team"] = true
        end
    end
    return teams
end

local function BuildTeamToggles()
    local teams = GetUniqueTeams()
    local teamNames = {}
    for name, _ in pairs(teams) do
        table.insert(teamNames, name)
    end
    table.sort(teamNames)

    for _, name in ipairs(teamNames) do
        if Settings.TargetTeams[name] == nil then
            Settings.TargetTeams[name] = true
        end
        TargetTab:CreateToggle({
            Name = name,
            CurrentValue = Settings.TargetTeams[name],
            Flag = "TargetTeam_" .. name,
            Callback = function(Value)
                Settings.TargetTeams[name] = Value
                SaveConfig()
            end
        })
    end
end

