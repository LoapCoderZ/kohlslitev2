local function GetTargets()
    local targets = {}
    local center = Camera.ViewportSize / 2
    local myTeam = LocalPlayer.Team
    local teamCheck = Settings.TeamCheck
    local wallCheck = Settings.WallCheck
    local players = Players:GetPlayers()
    local myChar = LocalPlayer.Character
    local maxDist = Settings.MaxDistance
    local fov = Settings.FOV
    local targetPartName = "Head"
    local inmatesFilter = Settings.InmatesFilter
    local ignoreForceField = Settings.IgnoreForceField
    local ignoreFriends = Settings.IgnoreFriends
    local targetTeams = Settings.TargetTeams

    CleanWhitelist()

    for i = 1, #players do
        local player = players[i]
        if player == LocalPlayer then continue end
        
        local character = player.Character
        if not character then continue end
        
        local humanoid = character:FindFirstChild("Humanoid")
        if not humanoid or humanoid.Health <= 0 then continue end

        local teamName = player.Team and player.Team.Name or "No Team"

        if teamName == "Neutral" then
            continue
        end

        if teamCheck and player.Team == myTeam then
            continue
        end

        if targetTeams[teamName] == false then
            continue
        end

        if inmatesFilter and teamName == "Inmates" then
            local punched = character:GetAttribute("PunchedSomeone") or false
            local hostile = character:GetAttribute("Hostile") or false
            local equipped = character:GetAttribute("EquipedHostileTool") or false
            local trespass = character:GetAttribute("Trespassing") or false
            if not (punched or hostile or equipped or trespass) then
                continue
            end
        end

        if ignoreForceField and character:FindFirstChild("ForceField") then
            continue
        end

        if ignoreFriends and player:IsFriendsWith(LocalPlayer.UserId) then
            continue
        end

        if IsInWhitelist(player) then
            continue
        end

        local targetPart = character:FindFirstChild(targetPartName)
        if not targetPart then continue end

        local distance = (Camera.CFrame.Position - targetPart.Position).Magnitude
        if distance > maxDist then continue end

        if wallCheck and myChar then
            local origin = Camera.CFrame.Position
            local direction = (targetPart.Position - origin).Unit * 1000
            local ray = Ray.new(origin, direction)
            local hit = workspace:FindPartOnRay(ray, myChar)
            if hit and not hit:IsDescendantOf(character) then
                continue
            end
        end

        local pos, onScreen = Camera:WorldToScreenPoint(targetPart.Position)
        if not onScreen then continue end

        local distToCenter = (Vector2.new(pos.X, pos.Y) - center).Magnitude
        if distToCenter > fov then continue end

        table.insert(targets, {
            player = player,
            character = character,
            targetPart = targetPart,
            distance = distance,
            distToCenter = distToCenter,
            health = humanoid.Health
        })
    end
    return targets
end

local function GetBestTarget(targets)
    if #targets == 0 then return nil end

    local priority = Settings.Priority
    if priority == "Closest to Center" then
        table.sort(targets, function(a, b) return a.distToCenter < b.distToCenter end)
    elseif priority == "Lowest Health" then
        table.sort(targets, function(a, b) return a.health < b.health end)
    elseif priority == "Highest Health" then
        table.sort(targets, function(a, b) return a.health > b.health end)
    end
    return targets[1]
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
